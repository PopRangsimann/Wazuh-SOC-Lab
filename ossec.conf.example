<!--
  ossec.conf.example  —  Wazuh SOC Lab (SANITIZED SAMPLE)
  =======================================================
  This is an ILLUSTRATIVE copy of the custom blocks used in this lab, with all
  secrets replaced by placeholders. It is safe to commit. Never commit the real
  ossec.conf — it may contain your VirusTotal API key.

  Blocks below are grouped by which host they belong to:
    * Wazuh MANAGER  (Linux server)  -> /var/ossec/etc/ossec.conf
    * Wazuh AGENT    (Windows 11)    -> C:\Program Files (x86)\ossec-agent\ossec.conf
-->


<!-- ===================================================================== -->
<!-- ===============  WAZUH MANAGER  (Linux server)  ====================== -->
<!-- ===================================================================== -->

<!-- VirusTotal enrichment: replace the placeholder with your own API key.
     Keep the real key OUT of the repo (that's what .gitignore is for). -->
<integration>
  <name>virustotal</name>
  <api_key>YOUR_VIRUSTOTAL_API_KEY_HERE</api_key>
  <group>syscheck</group>
  <alert_format>json</alert_format>
</integration>

<!-- pfSense syslog input (firewall log forwarding into Wazuh) -->
<remote>
  <connection>syslog</connection>
  <port>514</port>
  <protocol>udp</protocol>
  <allowed-ips>YOUR_PFSENSE_IP/32</allowed-ips>
  <local_ip>YOUR_WAZUH_SERVER_IP</local_ip>
</remote>


<!-- ===================================================================== -->
<!-- ===============  WAZUH AGENT  (Windows 11 endpoint)  ================= -->
<!-- ===================================================================== -->

<!-- File Integrity Monitoring: watch a folder in real time -->
<syscheck>
  <directories check_all="yes" report_changes="yes" realtime="yes">C:\FIM_Test</directories>
</syscheck>

<!-- Sysmon ingestion: pull Sysmon's operational channel into Wazuh -->
<localfile>
  <location>Microsoft-Windows-Sysmon/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<!-- Windows Security channel: source of logon events (e.g. 4625 / 4624) -->
<localfile>
  <location>Security</location>
  <log_format>eventchannel</log_format>
</localfile>

<!-- Suricata EVE JSON (network IDS alerts) -->
<localfile>
  <log_format>json</log_format>
  <location>C:\Program Files\Suricata\log\eve.json</location>
</localfile>
